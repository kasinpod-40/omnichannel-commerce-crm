{
  "name": "omnichannel-commerce-crm",
  "version": "1.9.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:run",
    "test:run": "npm run test:unit && npm run test:integration",
    "check:lockfile": "node scripts/check-lockfile-registry.mjs",
    "check": "npm run check:lockfile && npm run typecheck && npm run test:run && npm run deploy:dry",
    "cf-typegen": "wrangler types",
    "test:unit": "npm run test:unit:node && npm run test:unit:worker",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:unit:node": "vitest run --config vitest.config.mts",
    "test:unit:worker": "vitest run --config vitest.worker-unit.config.mts",
    "pc:schema:plan": "node scripts/apply-pc-runtime-schema.mjs --plan",
    "pc:schema:apply": "node scripts/apply-pc-runtime-schema.mjs --apply",
    "pc:schema:verify": "node scripts/apply-pc-runtime-schema.mjs --verify",
    "pc:descriptions:plan": "node scripts/apply-pc-field-descriptions.mjs --plan",
    "pc:descriptions:apply": "node scripts/apply-pc-field-descriptions.mjs --apply",
    "pc:descriptions:verify": "node scripts/apply-pc-field-descriptions.mjs --verify",
    "pc:notifications:plan": "node scripts/verify-pc-lark-group-notifications.mjs --plan",
    "pc:notifications:test": "node scripts/verify-pc-lark-group-notifications.mjs --send-test",
    "pc:notifications:verify": "node scripts/verify-pc-lark-group-notifications.mjs --verify"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^25.9.3",
    "typescript": "^5.5.2",
    "vitest": "~4.1.9",
    "wrangler": "^4.114.0"
  }
}
